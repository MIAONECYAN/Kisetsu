# Optional metadata providers. Replace placeholders only in your local .env.
TMDB_API_KEY=
BANGUMI_USER_AGENT="Kisetsu/1.0 (self-hosted)"

# Optional runtime locations. Relative paths are resolved from the repository.
KISETSU_DATA_DIR=./data
KISETSU_DB=./data/kisetsu.sqlite3
KISETSU_SECRETS_DB=./data/kisetsu-secrets.sqlite3

# Local backend listener. Use an address appropriate for your own network.
KISETSU_BACKEND_HOST=127.0.0.1
KISETSU_BACKEND_PORT=8000
